NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/zayan_portfolio
EMAIL_PROVIDER=smtp
SUPPORT_EMAIL=your-inbox@gmail.com

# For domainless Gmail delivery, set EMAIL_PROVIDER=smtp and use a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# For Resend instead, set EMAIL_PROVIDER=resend and provide a sender on a verified domain.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=Portfolio <no-reply@your-domain.com>
