NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/zayan_portfolio

# Resend keeps its API key on the server. Add your private key locally.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Zayan IT Hub <onboarding@resend.dev>"
SUPPORT_EMAIL="Zayan IT Hub <smiliesanjay@gmail.com>"
CONTACT_TO_EMAIL=sanjayknowss@gmail.com

# Without a verified domain, Resend's onboarding sender is for test delivery
# to the email address verified on your Resend account.

# Optional SMTP fallback:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM=your-gmail-address@gmail.com
